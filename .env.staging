COMPOSE_PROJECT_NAME=luran-staging
API_PORT=8001
ENVIRONMENT=staging

API_WORKERS=2
API_MEM_LIMIT=400m
WORKER_MEM_LIMIT=300m
DB_MEM_LIMIT=512m
REDIS_MEM_LIMIT=128m
REDIS_MAXMEMORY=96mb
QDRANT_MEM_LIMIT=400m
PGBOUNCER_MEM_LIMIT=96m

POSTGRES_SHARED_BUFFERS=128MB
POSTGRES_MAX_CONNECTIONS=40
POSTGRES_WORK_MEM=4MB
POSTGRES_EFFECTIVE_CACHE_SIZE=256MB
QDRANT_DEFAULT_SEGMENT_NUMBER=2
