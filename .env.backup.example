# ============================================================================
# Luran Database Backup Configuration
# ============================================================================
# Copy this file to .env or add these variables to your existing .env file
# ============================================================================

# ============================================================================
# Cloud Backup Settings
# ============================================================================
# Enable cloud backups (true/false)
ENABLE_CLOUD_BACKUP=false

# Cloud provider: s3, gdrive, dropbox
CLOUD_PROVIDER=gdrive

# ============================================================================
# AWS S3 Configuration (if using CLOUD_PROVIDER=s3)
# ============================================================================
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_S3_BUCKET=luran-db-backups
AWS_REGION=us-east-1

# ============================================================================
# Google Drive Configuration (if using CLOUD_PROVIDER=gdrive)
# ============================================================================
# Folder path in Google Drive (e.g., "LuranBackups")
GDRIVE_FOLDER=LuranBackups

# Note: You need to install and configure rclone:
# 1. Install: brew install rclone (macOS) or apt install rclone (Linux)
# 2. Configure: rclone config
# 3. Choose "Google Drive" and follow the authentication steps
# 4. Name the remote "gdrive" when prompted

# ============================================================================
# Dropbox Configuration (if using CLOUD_PROVIDER=dropbox)
# ============================================================================
# Folder path in Dropbox (e.g., "LuranBackups")
DROPBOX_FOLDER=LuranBackups

# Note: You need to install and configure rclone:
# 1. Install: brew install rclone (macOS) or apt install rclone (Linux)
# 2. Configure: rclone config
# 3. Choose "Dropbox" and follow the authentication steps
# 4. Name the remote "dropbox" when prompted

# ============================================================================
# Backup Retention
# ============================================================================
# Number of days to keep local backups (default: 30)
RETENTION_DAYS=30
