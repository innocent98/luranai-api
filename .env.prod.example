# ============================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ============================================================================
# This file shows the recommended production settings.
# Copy to .env when deploying to production and update with actual values.

# Application
PROJECT_NAME=Luran
VERSION=0.1.0
API_V1_STR=/api/v1
ENVIRONMENT=production  # IMPORTANT: Set to 'production' for prod

# Server
SERVER_HOST=https://api.luranai.com  # Your production API domain
SERVER_PORT=8000
FRONTEND_URL=https://app.luranai.com
FRONTEND_DOC_URL=https://luranai.com
API_WORKERS=4
LOG_LEVEL=info
TRIAL_EXPIRY_REMINDER_DAYS=14,7,3,1,0
SUBSCRIPTION_RENEWAL_REMINDER_DAYS=7,3,1

# Security (CRITICAL: Generate new secrets for production!)
SECRET_KEY=CHANGE_THIS_TO_RANDOM_SECRET_KEY_IN_PRODUCTION
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM=HS256
ENABLE_HSTS=true
RATE_LIMIT_FAIL_OPEN=true
RATE_LIMIT_ERROR_LOG_COOLDOWN_SECONDS=60
RAG_EXTRA_STOPWORDS=

# CORS (Update with your production frontend domains)
BACKEND_CORS_ORIGINS=["https://api.luranai.com","https://luranai.com","https://www.luranai.com","https://chat.luranai.com"]

# Database (Use production PostgreSQL instance)
DATABASE_URL=postgresql://prod_user:prod_password@prod-db-host:5432/luran_prod_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_RECYCLE=3600
DATABASE_POOL_PRE_PING=true

# Redis (Use production Redis instance)
REDIS_URL=redis://prod-redis-host:6379/0

# ============================================================================
# Qdrant Vector Database - PRODUCTION COLLECTION
# ============================================================================
# IMPORTANT: Use 'luran_knowledge_prod' for production to isolate from dev data
# Dev uses: luran_knowledge
# Prod uses: luran_knowledge_prod
QDRANT_URL=http://prod-qdrant-host:6333  # Or use Qdrant Cloud cluster
# CLUSTER_ENDPOINT=https://your-cluster.europe-west3-0.gcp.cloud.qdrant.io
QDRANT_API_KEY=YOUR_PRODUCTION_QDRANT_API_KEY
QDRANT_COLLECTION_NAME=luran_knowledge_prod  # PROD COLLECTION

# OpenAI
OPENAI_API_KEY=YOUR_PRODUCTION_OPENAI_API_KEY
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_LLM_MODEL=gpt-4o-mini
EMBEDDING_DIMENSION=1536

# Paystack
PAYSTACK_SECRET_KEY=sk_live_your_secret_key
PAYSTACK_PUBLIC_KEY=pk_live_your_public_key
PAYSTACK_BASE_URL=https://api.paystack.co

# Email (Production SMTP)
SMTP_TLS=true
SMTP_PORT=587
SMTP_HOST=smtp.gmail.com  # Or your production email service
SMTP_USER=support@luranai.com
SMTP_PASSWORD=YOUR_PRODUCTION_SMTP_PASSWORD
EMAILS_FROM_EMAIL=support@luranai.com
EMAILS_FROM_NAME=Luran Support

# Admin (Change default credentials!)
FIRST_SUPERUSER_EMAIL=admin@luranai.com
FIRST_SUPERUSER_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

# ============================================================================
# Database Backup Configuration
# ============================================================================
ENABLE_CLOUD_BACKUP=true
CLOUD_PROVIDER=gdrive
GDRIVE_FOLDER=LuranBackups_Production
RETENTION_DAYS=90  # Keep production backups longer

# ============================================================================
# Cloudinary Configuration (Image Upload Service)
# ============================================================================
# Sign up at https://cloudinary.com to get credentials
CLOUDINARY_CLOUD_NAME=your_production_cloud_name
CLOUDINARY_API_KEY=your_production_api_key
CLOUDINARY_API_SECRET=your_production_api_secret
CLOUDINARY_FOLDER=luran/widget_logos  # Folder for organizing uploads
