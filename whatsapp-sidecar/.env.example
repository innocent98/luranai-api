# Variable NAMES only. Never commit values. Generate secrets with e.g. `openssl rand -hex 32`.

# --- required ---
WHATSAPP_SIDECAR_TOKEN=            # bearer token the backend uses to call this service (>= 32 chars)
WHATSAPP_WEBHOOK_SECRET=           # HMAC secret for X-Luran-Signature on webhooks to the backend (>= 32 chars)
WHATSAPP_AUTH_MASTER_KEY=          # 64+ hex chars (32+ bytes); per-session keys are HKDF-derived from it. Losing it = every linked number must re-pair
BACKEND_BASE=                      # e.g. http://api:8000 ; webhooks go to ${BACKEND_BASE}/api/v1/webhooks/whatsapp/linked
WHATSAPP_SIDECAR_DATABASE_URL=     # Postgres, DIRECT (not through pgbouncer transaction pooling). Own schema `whatsapp_sidecar`
WHATSAPP_SIDECAR_REDIS_URL=        # Redis for leases and the daily send counter, e.g. redis://redis:6379/1

# --- optional (defaults shown) ---
# WHATSAPP_WEBHOOK_SECRET_PREVIOUS=  # set during secret rotation on the backend side too; not used for signing
# MAX_SESSIONS=3                     # capacity guard: POST /sessions -> 503 at/above this many active sessions
# RSS_REFUSE_MB=400                  # capacity guard: POST /sessions -> 503 when process RSS is at/above this
# SEND_PER_MIN=6                     # per-session send token bucket
# DAILY_SEND_CAP=200                 # per-session sends per UTC day
# REPLY_WINDOW_HOURS=24              # reply-only: a chat is repliable this long after its last inbound message
# RESTORE_STAGGER_MS=2000            # boot restore: one session per this many ms (+ up to 1 s jitter)
# LEASE_TTL_MS=30000                 # Redis lease ttl; heartbeat every ttl/3
# PAIRING_TTL_MS=600000              # unpaired sessions are expired to logged_out(408) after this
# LISTEN_HOST=127.0.0.1              # the Docker image sets 0.0.0.0 (compose network only, no published port)
# PORT=8787
# LOG_LEVEL=info
