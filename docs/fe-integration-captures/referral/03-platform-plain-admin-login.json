{
  "description": "The plain ADMIN signs in.",
  "request": {
    "method": "POST",
    "path": "/api/v1/platform/auth/login",
    "query": {},
    "headers": {
      "content-type": "application/json"
    },
    "body": {
      "email": "admin.placeholder@example.com",
      "password": "Placeholder-Pass-123!"
    }
  },
  "response": {
