          "next_node_id": "end_or_human"
        }
      },
      {
        "id": "data_troubleshoot",
        "type": "text_input",
        "config": {
          "prompt": "Please describe the issue (location, error, time).",
          "save_to": "user_problem",
          "validation": {
            "type": "text",
            "value": 5,
            "error": "Please provide a bit more detail."
          },
          "acknowledgment": "Thanks. Let me check this.",
          "next_node_id": "data_ai_help"
        }
      },
      {
        "id": "data_ai_help",
        "type": "ai_action",
        "config": {
          "prompt": "Customer selected Data support and reported: {{user_problem}}. Provide concise troubleshooting steps, then ask if they want human support.",
          "save_to": "ai_output",
          "use_rag": true,
          "rag_key": "rag_response",
          "auto_retrieve": true,
          "max_tokens": 350,
          "max_history_turns": 8,
          "next_node_id": "end_or_human"
        }
      },
      {
        "id": "services_ai_help",
        "type": "ai_action",
        "config": {
          "prompt": "Customer selected Services support: {{services_issue}}. Give practical steps and ask whether to escalate to human.",
          "save_to": "ai_output",
          "use_rag": true,
          "rag_key": "rag_response",
          "auto_retrieve": true,
          "max_tokens": 350,
          "max_history_turns": 8,
          "next_node_id": "end_or_human"
        }
      },
      {
        "id": "airtime_not_credited",
        "type": "text_input",
        "config": {
          "prompt": "Please share amount, payment channel, and time.",
          "save_to": "airtime_details",
          "validation": {
            "type": "text",
            "value": 5,
            "error": "Please include transaction details."
          },
          "acknowledgment": "Thanks. I will escalate this for review.",
          "next_node_id": "escalate_human"
        }
      },
      {
        "id": "end_or_human",
        "type": "question",
        "config": {
          "question": "Did this solve your issue?",
          "save_to": "resolved",
          "options": [
            {
              "label": "Yes, solved",
              "value": "yes",
              "next_node_id": "end_node",
              "acknowledgment": "Great, happy to help."
            },
            {
              "label": "No, talk to human",
              "value": "no",
              "next_node_id": "escalate_human",
              "acknowledgment": "Understood, escalating to human support."
            }
          ]
        }
      },
      {
        "id": "escalate_human",
        "type": "escalate",
        "config": {
          "reason": "Customer requested human support or issue unresolved in guided flow.",
          "message": "I’m connecting you with a human support agent now."
