# ==========================================
# LURAN VPS PRODUCTION CONFIGURATION
# ==========================================

# Environment
PROJECT_NAME=Luran
VERSION=0.1.0
API_V1_STR=/api/v1
ENVIRONMENT=production
COMPOSE_PROJECT_NAME=luran
API_IMAGE=luran-api:latest

# Server
SERVER_HOST=https://yourdomain.com
SERVER_PORT=8000
API_PORT=8000
FRONTEND_URL=https://app.yourdomain.com
CUSTOMER_FRONTEND_URL=https://chat.yourdomain.com
FRONTEND_DOC_URL=https://yourdomain.com
API_WORKERS=3
LOG_LEVEL=info
TRIAL_EXPIRY_REMINDER_DAYS=14,7,3,1,0
SUBSCRIPTION_RENEWAL_REMINDER_DAYS=7,3,1

# Memory profile
# Production-friendly defaults for a shared 8 GiB VPS.
API_MEM_LIMIT=900m
WORKER_MEM_LIMIT=700m
DB_MEM_LIMIT=1200m
REDIS_MEM_LIMIT=256m
REDIS_MAXMEMORY=256mb
QDRANT_MEM_LIMIT=900m
PGBOUNCER_MEM_LIMIT=128m
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_MAX_CONNECTIONS=100
POSTGRES_WORK_MEM=8MB
POSTGRES_EFFECTIVE_CACHE_SIZE=512MB
QDRANT_DEFAULT_SEGMENT_NUMBER=4

# ==========================================
# SECURITY (REQUIRED)
# ==========================================

# Generate using: openssl rand -hex 32
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM=HS256
ENABLE_HSTS=false
RATE_LIMIT_FAIL_OPEN=true
RATE_LIMIT_ERROR_LOG_COOLDOWN_SECONDS=60
RAG_EXTRA_STOPWORDS=

# ==========================================
# CORS
# ==========================================

BACKEND_CORS_ORIGINS=[https://yourdomain.com,https://www.yourdomain.com]

# ==========================================
# DATABASE
# ==========================================

POSTGRES_USER=luran_user
POSTGRES_PASSWORD=
POSTGRES_DB=luran_db
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40
DATABASE_POOL_RECYCLE=3600
DATABASE_POOL_PRE_PING=true

# ==========================================
# REDIS
# ==========================================

REDIS_URL=redis://redis:6379/0

# ==========================================
# --- Agent Caller (escalation push) ---
# ==========================================
# FIREBASE_CREDENTIALS_JSON is the raw Firebase service-account JSON, collapsed
# to a single line. It lives only in the encrypted .env.{stage} bundles managed
# by scripts/env.sh — never commit a real value here.
FIREBASE_CREDENTIALS_JSON=
AGENT_ALERT_ENABLED=true
AGENT_ALERT_WAIT_SECONDS=90
AGENT_ALERT_ANDROID_CHANNEL_ID=luran_escalation

# ==========================================
# QDRANT
# ==========================================

# Production should use 'luran_knowledge_prod' collection for data isolation
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=luran_knowledge_prod
        
# ==========================================
# OPENAI (REQUIRED)
# ==========================================

OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_LLM_MODEL=gpt-6-luna
# reasoning_effort for gpt-6/reasoning models: none|low|medium|high|xhigh
OPENAI_REASONING_EFFORT=low
EMBEDDING_DIMENSION=1536

# ==========================================
# PAYSTACK (REQUIRED FOR BILLING)
# ==========================================

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_PLAN_LITE_MONTHLY=
PAYSTACK_PLAN_LITE_ANNUAL=
PAYSTACK_PLAN_PROFESSIONAL_MONTHLY=
PAYSTACK_PLAN_PROFESSIONAL_ANNUAL=
PAYSTACK_PLAN_GROWTH_MONTHLY=
PAYSTACK_PLAN_GROWTH_ANNUAL=

# ==========================================
# ADMIN USER
# ==========================================

FIRST_SUPERUSER_EMAIL=admin@yourdomain.com
FIRST_SUPERUSER_PASSWORD=

# ==========================================
# ENCRYPTION_KEY
# ==========================================
ENCRYPTION_KEY=encryption_key_here
ENCRYPTION_MIGRATION_MODE=false
ENCRYPTION_KEY_PREVIOUS=<current encryption key if rotating, otherwise leave blank>

# ==========================================
# EMAIL (OPTIONAL)
# ==========================================

SMTP_TLS=true
SMTP_PORT=587
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=
EMAILS_FROM_NAME=

# ==========================================
# CLOUDINARY (OPTIONAL)
# ==========================================

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=luran/widget_logos
CLOUDINARY_PLATFORM_EMAIL_FOLDER=luran/platform_email_images

# ==========================================
# BACKUP (OPTIONAL)
# ==========================================

ENABLE_CLOUD_BACKUP=false
CLOUD_PROVIDER=
GDRIVE_FOLDER=
RETENTION_DAYS=30

# ==========================================
# VOICE CHAT (ElevenLabs Agents)
# ==========================================
# Required for voice. All three secrets default to None so a missing .env
# cannot boot an insecure config — voice returns 503 voice_not_configured
# rather than starting up in a half-configured state.

# From your ElevenLabs account (Agents requires a paid plan).
# IMPORTANT: this key MUST have the `convai_write` permission — the backend
# mints WebRTC conversation tokens, and a read-only key fails with
# 401 missing_permissions. Set the scope when creating the key in the
# ElevenLabs dashboard (API Keys -> Conversational AI -> write).
ELEVENLABS_API_KEY=
# The Agent you create in the ElevenLabs dashboard, configured with a custom
# LLM URL pointing at POST /api/v1/voice/llm/chat/completions on this API.
ELEVENLABS_AGENT_ID=
ELEVENLABS_API_BASE=https://api.elevenlabs.io

# You generate this yourself — it is NOT from ElevenLabs. Set the SAME value
# here and in the Agent's custom-LLM Authorization header, as: Bearer <secret>
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Unsetting this fails closed: every inbound ElevenLabs request is rejected 401.
VOICE_SHARED_SECRET=

# Idle timeout on a voice session token, in seconds. Renewed on every
# conversational turn, so this bounds silence, not total call length.
VOICE_SESSION_TOKEN_TTL_SECONDS=600
# Per-tenant ceiling on simultaneous voice calls. Keep at or below your
# ElevenLabs plan's concurrency limit (~20 Pro / ~40 Business).
VOICE_MAX_CONCURRENT_SESSIONS=20
